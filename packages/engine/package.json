{
	"name": "@app/engine",
	"version": "0.1.0",
	"private": true,
	"description": "Shared gameplay engine logic for browser-heroes-2.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@app/content": "workspace:*",
		"zod": "^4.3.6"
	},
	"scripts": {
		"dev": "tsc -w -p tsconfig.build.json",
		"build": "tsc -b tsconfig.build.json",
		"typecheck": "tsc -b tsconfig.build.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.0.18",
		"vitest": "^4.0.18"
	}
}
