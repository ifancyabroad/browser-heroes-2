{
	"name": "@app/content",
	"version": "0.1.0",
	"private": true,
	"description": "Game content definitions and schemas for browser-heroes-2.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18.18"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsc -w -p tsconfig.build.json",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.build.json --noEmit",
		"lint": "eslint .",
		"generate:content": "tsx src/scripts/generateContent.ts",
		"generate:content:watch": "chokidar \"src/{skills,enemies,items,classes}/**/*.ts\" -c \"pnpm run generate:content\" --initial"
	},
	"dependencies": {
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^18.16.0",
		"chokidar-cli": "^3.0.0",
		"tsx": "^3.12.7"
	}
}
