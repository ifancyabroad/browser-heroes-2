{
	"name": "@app/content",
	"version": "0.1.0",
	"private": true,
	"description": "Game content definitions and schemas for browser-heroes-2.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18.18"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "pnpm run generate:content && concurrently \"pnpm run dev:types\" \"pnpm run watch:content\"",
		"dev:types": "tsc -w -p tsconfig.build.json",
		"prebuild": "pnpm run generate:content",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
		"lint": "eslint .",
		"generate:content": "tsx scripts/generateContent.ts",
		"watch:content": "chokidar \"src/**/*.ts\" \"scripts/**/*.ts\" -i \"src/generated/**\" -c \"pnpm run generate:content\""
	},
	"dependencies": {
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^18.16.0",
		"chokidar-cli": "^3.0.0",
		"concurrently": "^10.0.3",
		"tsx": "^3.12.7"
	}
}
