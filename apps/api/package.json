{
	"name": "@app/api",
	"version": "0.1.0",
	"private": true,
	"description": "Express + Mongoose API (TypeScript).",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18.18"
	},
	"scripts": {
		"dev": "tsx watch ./src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"cleanup:guests": "tsx ./src/scripts/cleanupGuests.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@app/content": "workspace:*",
		"@app/engine": "workspace:*",
		"@app/shared": "workspace:*",
		"@aws-sdk/client-ses": "3.1104.0",
		"argon2": "^0.44.0",
		"compression": "^1.8.1",
		"connect-mongo": "^6.0.0",
		"cors": "^2.8.6",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"express-rate-limit": "^8.0.1",
		"helmet": "^8.1.0",
		"leo-profanity": "^1.9.0",
		"mongoose": "^9.9.1",
		"socket.io": "^4.8.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.0.18",
		"@types/supertest": "^6.0.3",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/node": "^25.0.10",
		"tsx": "^4.21.0",
		"supertest": "^7.1.4",
		"typescript": "~5.9.3",
		"vitest": "^4.0.18"
	}
}
