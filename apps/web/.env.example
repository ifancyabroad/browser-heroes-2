# Shared public metadata defaults are committed in .env.

# Optional frontend service overrides
# VITE_API_BASE_URL=
# VITE_SOCKET_URL=
# VITE_IMAGE_BASE_URL=

# Set to exactly "true" to replace the web app with the holding page.
VITE_HOLDING_PAGE_ENABLED=false

# Client-visible key used by ?holding_bypass=<key> while the holding page is enabled.
VITE_HOLDING_PAGE_BYPASS_KEY=
